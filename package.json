{
  "name": "chaua-educa",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5501",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "format": "prettier --write src tests index.html vite.config.ts tsconfig.json README.md docs",
    "art:build": "python scripts/generate_art.py && node scripts/export_art.cjs && python scripts/validate_art.py"
  },
  "dependencies": {
    "phaser": "3.90.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "prettier": "3.6.2",
    "sharp": "0.34.5",
    "typescript": "~5.9.3",
    "vite": "^7.1.0",
    "vitest": "^3.2.4"
  }
}
