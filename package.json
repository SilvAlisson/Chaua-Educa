{
  "name": "chaua-educa",
  "version": "2.5.0",
  "private": true,
  "type": "module",
  "description": "Uma aventura educativa do papagaio-chauá pela Mata Atlântica.",
  "scripts": {
    "start": "python scripts/dev-server.py",
    "build": "sass --no-source-map Chaua-Educa-main/scss/style.scss Chaua-Educa-main/css/style.css",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node tests/browser-smoke.cjs",
    "test:quality": "node tests/browser-quality.cjs",
    "test:render-profile": "node tests/browser-render-profile.cjs",
    "benchmark:render-profile": "node scripts/benchmark-render-profile.cjs",
    "dev": "python scripts/dev-server.py",
    "test:journey": "node tests/browser-journey.cjs",
    "test:visual": "node tests/browser-visual.cjs",
    "test:immersion": "node tests/browser-immersion.cjs",
    "test:reference-art": "node tests/browser-reference-art.cjs",
    "test:snake": "node tests/browser-snake-strike.cjs",
    "test:snake-continuity": "node tests/browser-snake-continuity.cjs",
    "test:background": "node tests/browser-background.cjs",
    "benchmark:background": "node tests/browser-background.cjs --benchmark",
    "test:hud": "node tests/browser-hud.cjs",
    "benchmark:hotspots": "node scripts/diagnose-render-cost.cjs",
    "benchmark:resolution": "node scripts/benchmark-resolution-ladder.cjs",
    "benchmark:long-flight": "node scripts/benchmark-long-journey.cjs",
    "test:perf-probe": "node tests/browser-perf-probe.cjs",
    "test:auto-visual": "node scripts/capture-auto-visual.cjs",
    "test:snake-raster-parity": "node tests/browser-snake-raster-parity.cjs",
    "benchmark:snake-a2": "node scripts/benchmark-snake-a2.cjs",
    "benchmark:render-parts": "node scripts/benchmark-render-parts.cjs",
    "benchmark:background-passes": "node scripts/benchmark-background-passes.cjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "playwright": "1.62.1",
    "sass": "1.105.1"
  }
}
